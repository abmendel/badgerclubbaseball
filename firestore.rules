rules_version = '2';
// Badger Club Baseball HQ — Firestore security rules.
// Two shared logins: the board password signs in as board@badgerclub.example,
// the member password as member@badgerclub.example. No owner, no editors list.
service cloud.firestore {
  match /databases/{database}/documents {
    function email() { return request.auth != null ? request.auth.token.email : ''; }
    function isBoard() { return email() == 'board@badgerclub.example'; }
    function isMember() { return isBoard() || email() == 'member@badgerclub.example'; }

    match /{c}/{id} {
      // Member view: roster, board list, announcements, attendance, carpools, scouting, settings.
      allow read: if (isMember() && c in ['board','announcements','players','attendance','carpools','scouting','settings'])
                  // Board only: calendar, deadlines, tasks, dues, officer dues, form responses.
                  || (isBoard() && c in ['events','deadlines','tasks','dues','officerdues','forms']);
      // Only the board password can change anything.
      allow write: if isBoard() && c in ['events','deadlines','tasks','board','forms','announcements',
        'dues','officerdues','players','attendance','carpools','scouting','settings'];
    }

    // Sideline (abmendel.github.io/sideline): picks synced between devices under a long random
    // sync code. Only someone holding the code can read or change that one document; nothing can
    // be listed or deleted, and only the sport fields are accepted.
    match /sideline/{code} {
      allow get: if code.size() >= 20;
      allow create, update: if code.size() >= 20
        && request.resource.data.keys().hasOnly(['nba','nfl','mlb','nhl','soccer','updated']);
    }
  }
}
